generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  RESCHEDULED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  SYSTEM
  BOOKING
  PAYMENT
  SECURITY
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  phone               String?              @unique
  passwordHash        String?
  role                Role                 @default(USER)
  isVerifiedEmail     Boolean              @default(false)
  isVerifiedPhone     Boolean              @default(false)
  mfaEnabled          Boolean              @default(false)
  failedLoginAttempts Int                  @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  
  // Google Sign-In properties
  image               String?
  emailVerified       Boolean              @default(false)
  accountStatus       String               @default("ACTIVE")
  lastLoginAt         DateTime?
  lastLoginIP         String?
  accountLockedUntil  DateTime?

  bookings            Booking[]
  payments            Payment[]
  notifications       Notification[]
  savedArticles       Article[]            @relation("SavedArticles")
  emailOtps           EmailOtp[]
  smsOtps             SmsOtp[]
  mfaOtps             MfaOtp[]
  passwordResetTokens PasswordResetToken[]
  accounts            Account[]
  sessions            Session[]
  auditLogs           AuditLog[]
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  email       String
  phone       String
  interest    String
  message     String
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Booking {
  id           String        @id @default(uuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  serviceName  String
  date         String
  time         String
  meetingMode  String
  name         String
  email        String
  phone        String
  message      String
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  payments     Payment[]
}

model Payment {
  id               String        @id @default(uuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  bookingId        String?
  booking          Booking?      @relation(fields: [bookingId], references: [id])
  amount           Float
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  razorpayOrderId  String        @unique
  razorpayPaymentId String?      @unique
  razorpaySignature String?
  service          String
  tax              Float
  total            Float
  invoiceNumber    String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Article {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  content       String
  author        String
  readingTime   String
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  featuredImage String
  seoTitle      String
  seoDesc       String
  seoKeywords   String
  publishedAt   DateTime  @default(now())
  isPublished   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  savedBy       User[]    @relation("SavedArticles")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  details   String
  ipAddress String
  createdAt DateTime @default(now())
}

model Analytics {
  id        String   @id @default(uuid())
  eventType String
  pagePath  String
  referrer  String
  deviceType String
  country   String
  ipAddress String
  sessionId String
  createdAt DateTime @default(now())
}

model EmailOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, used])
}

model SmsOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, used])
}

model MfaOtp {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, used])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
}

model RateLimitLog {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())
  @@index([key, createdAt])
}

model Account {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  provider      String
  providerId    String
  providerEmail String?
  createdAt     DateTime @default(now())
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  deviceId         String
  ipAddress        String
  userAgent        String
  refreshTokenHash String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}


